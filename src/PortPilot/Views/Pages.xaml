<ResourceDictionary x:Class="PortPilot.Views.Pages" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:PortPilot.Helpers">
 <helpers:EqualityConverter x:Key="Equality"/>
 <ContextMenu x:Key="RowMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
  <MenuItem Header="复制完整信息" Command="{Binding CopyCommand}"/>
  <MenuItem Header="复制端口" Command="{Binding CopyCommand}" CommandParameter="port"/>
  <MenuItem Header="复制 PID" Command="{Binding CopyCommand}" CommandParameter="pid"/>
  <MenuItem Header="复制进程名称" Command="{Binding CopyCommand}" CommandParameter="name"/>
  <MenuItem Header="复制路径" Command="{Binding CopyCommand}" CommandParameter="path"/>
  <MenuItem Header="复制启动参数" Command="{Binding CopyCommand}" CommandParameter="command"/>
  <Separator/><MenuItem Header="打开文件位置" Command="{Binding OpenLocationCommand}"/>
  <MenuItem Header="查看该 PID 的全部端口" Command="{Binding ViewPidPortsCommand}"/>
  <MenuItem Header="收藏端口" Command="{Binding FavoritePortCommand}"/>
  <MenuItem Header="收藏 PID" Command="{Binding FavoriteProcessCommand}" CommandParameter="pid"/>
  <MenuItem Header="收藏进程名称" Command="{Binding FavoriteProcessCommand}" CommandParameter="process"/>
  <Separator/><MenuItem Header="正常结束进程…" Command="{Binding KillCommand}" CommandParameter="normal"/>
  <MenuItem Header="Force Kill…" Command="{Binding KillCommand}" CommandParameter="force" Foreground="{DynamicResource DangerBrush}"/>
  <MenuItem Header="结束进程树…" Command="{Binding KillCommand}" CommandParameter="tree" Foreground="{DynamicResource DangerBrush}"/>
 </ContextMenu>
 <DataTemplate x:Key="PortTable">
  <DataGrid x:Name="Table" ItemsSource="{Binding PortsView}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Tag="{Binding}" ContextMenu="{StaticResource RowMenu}" PreviewMouseRightButtonDown="GridRightClick" PreviewKeyDown="GridKeyDown" SelectionChanged="GridSelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="78" ElementStyle="{StaticResource Mono}"/>
    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
    <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="145"/>
    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" ElementStyle="{StaticResource Mono}"/>
    <DataGridTemplateColumn Header="State" SortMemberPath="State" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{DynamicResource HoverBrush}" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left"><TextBlock Text="{Binding State}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding State}" Value="LISTENING"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="140"/>
    <DataGridTextColumn Header="Note / Hint" Binding="{Binding PortLabel}" Width="160"/>
    <DataGridTextColumn Header="Remote address" Binding="{Binding RemoteAddress}" Width="160"/>
    <DataGridTextColumn Header="Remote port" Binding="{Binding RemotePort}" Width="100"/>
    <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu, StringFormat=F1}" Width="80" ElementStyle="{StaticResource Mono}"/>
    <DataGridTextColumn Header="Memory MB" Binding="{Binding Memory, StringFormat=F1}" Width="110" ElementStyle="{StaticResource Mono}"/>
    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="190"/>
    <DataGridTextColumn Header="Process path" Binding="{Binding Path}" Width="320"/>
    <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="170"/>
   </DataGrid.Columns>
  </DataGrid>
 </DataTemplate>
 <DataTemplate x:Key="ProcessTable">
  <DataGrid ItemsSource="{Binding ProcessesView}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Tag="{Binding}" ContextMenu="{StaticResource RowMenu}" PreviewMouseRightButtonDown="GridRightClick" PreviewKeyDown="GridKeyDown" SelectionChanged="GridSelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="190"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" ElementStyle="{StaticResource Mono}"/>
    <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu, StringFormat=F1}" Width="85" ElementStyle="{StaticResource Mono}"/><DataGridTextColumn Header="Memory MB" Binding="{Binding Memory, StringFormat=F1}" Width="110" ElementStyle="{StaticResource Mono}"/>
    <DataGridTextColumn Header="Connections" Binding="{Binding ConnectionCount}" Width="105"/><DataGridTextColumn Header="Listening ports" Binding="{Binding ListeningPorts}" Width="170"/>
    <DataGridTextColumn Header="Parent PID" Binding="{Binding ParentPid}" Width="95"/><DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="80"/><DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="80"/>
    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="180"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="330"/><DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="180"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
 </DataTemplate>
 <DataTemplate x:Key="ConnectionTable">
  <DataGrid ItemsSource="{Binding ConnectionsView}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Tag="{Binding}" ContextMenu="{StaticResource RowMenu}" PreviewMouseRightButtonDown="GridRightClick" PreviewKeyDown="GridKeyDown" SelectionChanged="GridSelectionChanged"><DataGrid.Columns>
   <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75" ElementStyle="{StaticResource Mono}"/><DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
   <DataGridTextColumn Header="Local endpoint" Binding="{Binding Local}" Width="190"/><DataGridTextColumn Header="Remote endpoint" Binding="{Binding Remote}" Width="195"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Observed duration" Binding="{Binding Duration}" Width="145"/>
  </DataGrid.Columns></DataGrid>
 </DataTemplate>
 <DataTemplate x:Key="FilterBar">
  <ItemsControl ItemsSource="{Binding Filters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Button Content="{Binding}" Margin="0,0,6,8" Padding="12,6" MinHeight="30" FontSize="12" Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource Equality}"><Binding/><Binding Path="DataContext.Filter" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </DataTemplate>
 <DataTemplate x:Key="EmptyState">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
   <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="32" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
   <TextBlock Text="{Binding EmptyTitle}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding EmptyDescription}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,10,0,16"/>
   <Button Content="收藏并持续监控" Command="{Binding FavoritePortCommand}" Visibility="{Binding CanFavoriteQuery, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="PortsPage">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilterBar}"/>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><ContentControl Content="{Binding}" ContentTemplate="{StaticResource PortTable}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmptyState}" IsHitTestVisible="{Binding IsEmpty}"/></Grid></Border>
   <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding VisibleCount, StringFormat={}{0} endpoints}" Style="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制选中" Click="CopySelected" Margin="6,0"/><Button Content="收藏选中" Click="FavoriteSelected" Margin="0,0,6,0"/><Button Content="导出选中" Click="ExportSelected" Margin="0,0,6,0"/><Button Content="结束相关进程…" Click="KillSelected" Style="{StaticResource DangerButton}"/></StackPanel></DockPanel>
  </Grid>
 </DataTemplate>
 <DataTemplate x:Key="ProcessesPage">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><CheckBox Content="进程树" IsChecked="{Binding TreeMode}" Margin="0,8,24,8"/><CheckBox Content="只看有网络连接的进程" IsChecked="{Binding OnlyNetworkProcesses}"/></StackPanel><TextBlock Text="{Binding VisibleCount, StringFormat={}{0} processes}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessTable}"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding TreeMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
    <TreeView ItemsSource="{Binding ProcessTree}" SelectedItemChanged="TreeSelected" Visibility="{Binding TreeMode, Converter={StaticResource BoolVisibility}}" Padding="12"/>
   </Grid></Border><TextBlock Grid.Row="2" Text="选择进程查看启动参数、父子关系和全部网络端点。Ctrl / Shift 可多选。" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
  </Grid>
 </DataTemplate>
 <DataTemplate x:Key="ConnectionsPage"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilterBar}"/>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConnectionTable}"/><ContentControl Content="{Binding}" ContentTemplate="{StaticResource EmptyState}" IsHitTestVisible="{Binding IsEmpty}"/></Grid></Border>
  <TextBlock Grid.Row="2" Text="搜索支持进程、PID:1234、远程 IP、远程端口和状态。观测时长不代表实际连接建立时间。" Style="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap"/>
 </Grid></DataTemplate>
 <DataTemplate x:Key="ActivityItem"><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat=HH:mm}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SecondaryBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Action}" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate>
 <DataTemplate x:Key="PortChips"><ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,8,8" Command="{Binding DataContext.SearchPortCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate>
 <DataTemplate x:Key="DashboardPage">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Background="{DynamicResource SelectionBrush}" CornerRadius="12" Padding="22,18" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your local network, in focus." FontSize="21" FontWeight="SemiBold"/><TextBlock Text="端口 → 连接 → 进程。每一次排查，都有清晰的起点。" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="查看端口  →" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Ports" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid></Border>
   <UniformGrid Columns="5" Margin="-5,0,-5,22">
    <Border Style="{StaticResource Card}" Margin="5,0" Padding="16"><StackPanel><TextBlock Text="监听端口" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ListeningCount}" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,7"/><TextBlock Text="LISTENING" FontSize="9" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="5,0" Padding="16"><StackPanel><TextBlock Text="TCP 连接" Style="{StaticResource Muted}"/><TextBlock Text="{Binding TcpCount}" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,7"/><TextBlock Text="TCP · IPv4 + IPv6" FontSize="9" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="5,0" Padding="16"><StackPanel><TextBlock Text="UDP 端点" Style="{StaticResource Muted}"/><TextBlock Text="{Binding UdpCount}" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,7"/><TextBlock Text="UDP · IPv4 + IPv6" FontSize="9" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="5,0" Padding="16"><StackPanel><TextBlock Text="运行进程" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ProcessCount}" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,7"/><TextBlock Text="ALL PROCESSES" FontSize="9" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="5,0" Padding="16" ToolTip="常见敏感端口监听在所有地址上的条目数。仅提示检查绑定范围，不代表已确认漏洞。"><StackPanel><TextBlock Text="需留意的监听" Style="{StaticResource Muted}"/><TextBlock Text="{Binding RiskCount}" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,7"/><TextBlock Text="绑定范围提示" FontSize="9" Foreground="{DynamicResource WarningBrush}"/></StackPanel></Border>
   </UniformGrid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0">
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="快速查找" Style="{StaticResource SectionTitle}"/><TextBlock Text="常用开发端口" Style="{StaticResource Muted}" Margin="0,0,0,12"/><ContentControl Content="{Binding CommonPorts}" ContentTemplate="{StaticResource PortChips}"/><TextBlock Text="服务名称是端口惯例，实际程序请查看进程详情。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="收藏与监控" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Favorites}"><ItemsControl.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Command="{Binding DataContext.QueryFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><DockPanel><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{DynamicResource SuccessBrush}" FontSize="11"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="收藏端口后，在这里查看实时占用状态。" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="最近使用端口" Style="{StaticResource SectionTitle}"/><ContentControl Content="{Binding RecentPorts}" ContentTemplate="{StaticResource PortChips}"/><TextBlock Text="点击端口即可再次查询。" Style="{StaticResource Muted}"/></StackPanel></Border>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="最近活动" Style="{StaticResource SectionTitle}"/><Button Content="全部" Command="{Binding NavigateCommand}" CommandParameter="History" HorizontalAlignment="Right" Padding="9,3" MinHeight="24" VerticalAlignment="Top"/></DockPanel><ItemsControl ItemsSource="{Binding RecentHistory}" ItemTemplate="{StaticResource ActivityItem}"/><TextBlock Text="查询和操作记录将保存在本机。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="最近查看的 PID" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding RecentPids}" ItemTemplate="{StaticResource ActivityItem}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="最近结束的进程" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding RecentKills}" ItemTemplate="{StaticResource ActivityItem}"/></StackPanel></Border>
    </StackPanel>
   </Grid>
  </StackPanel></ScrollViewer>
 </DataTemplate>
 <DataTemplate x:Key="FavoritesPage"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite}" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="75"/><DataGridTextColumn Header="端口 / PID / 进程" Binding="{Binding Value}" Width="150"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="占用进程" Binding="{Binding Owner}" Width="200"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="200"/></DataGrid.Columns></DataGrid></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="编辑收藏" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><TextBox Text="{Binding FavoriteName, UpdateSourceTrigger=PropertyChanged}" ToolTip="收藏名称" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding FavoriteNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="备注"/></Grid><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="保存" Command="{Binding SaveFavoriteCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="查询" Command="{Binding QueryFavoriteCommand}" CommandParameter="{Binding SelectedFavorite}" Margin="0,0,8,0"/><Button Content="移除" Command="{Binding RemoveFavoriteCommand}" CommandParameter="{Binding SelectedFavorite}"/><TextBlock Text="PID 收藏跟随编号，可能匹配未来复用该 PID 的进程。" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
 </Grid></DataTemplate>
 <DataTemplate x:Key="HistoryPage"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock Text="最多保留 1000 条 · 仅保存在 data/history.json" Style="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="清空历史…" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding History}"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="175"/><DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="135"/><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></DataTemplate>
 <DataTemplate x:Key="SearchPage"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ports &amp; Connections" Style="{StaticResource SectionTitle}"/><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource PortTable}"/></Border><TextBlock Grid.Row="2" Text="Processes" Style="{StaticResource SectionTitle}" Margin="0,18,0,12"/><Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessTable}"/></Border><StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock Text="Favorites" Style="{StaticResource Muted}"/><ItemsControl ItemsSource="{Binding SearchFavorites}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Margin="0,8,8,0" Command="{Binding DataContext.QueryFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></DataTemplate>
 <DataTemplate x:Key="SettingsPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="General" Style="{StaticResource SectionTitle}"/><CheckBox Content="自动刷新本机网络与进程" IsChecked="{Binding Settings.AutoRefresh}"/><CheckBox Content="显示系统进程" IsChecked="{Binding Settings.ShowSystemProcesses}"/><TextBlock Text="安全策略：结束进程始终确认；关键系统进程始终保护。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Appearance &amp; Refresh" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="主题" Style="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Settings.Theme}" Margin="0,0,16,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="刷新周期（毫秒）" Style="{StaticResource Muted}" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding Settings.RefreshInterval}"/></StackPanel></Grid><Button Content="保存设置" Command="{Binding ApplySettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Portable Data" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding DataDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,0,0,14"/><WrapPanel><Button Content="打开数据目录" Command="{Binding OpenDirectoryCommand}" Margin="0,0,8,8"/><Button Content="打开日志" Command="{Binding OpenDirectoryCommand}" CommandParameter="logs" Margin="0,0,8,8"/><Button Content="清除详情缓存" Command="{Binding ClearCacheCommand}" Margin="0,0,8,8"/><Button Content="清空历史…" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="About PortPilot" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding About, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"/><Button Content="以管理员权限重新打开" Command="{Binding ElevateReaderCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer></DataTemplate>
</ResourceDictionary>
